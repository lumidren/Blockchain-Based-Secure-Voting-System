{
  "name": "verivote",
  "version": "0.1.0",
  "private": true,
  "description": "VeriVote: end-to-end verifiable voting on the EVM with ZK eligibility proofs and threshold homomorphic tallying",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "circuits:build": "pnpm --filter @verivote/circuits build",
    "circuits:ceremony": "pnpm --filter @verivote/circuits ceremony",
    "contracts:test": "cd contracts && forge test -vvv",
    "contracts:coverage": "cd contracts && forge coverage --report lcov --report summary",
    "e2e:local": "node tools/load-test/dist/e2e-local.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
